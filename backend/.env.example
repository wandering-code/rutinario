# Contraseña del único usuario (el administrador). Obligatoria.
ADMIN_PASSWORD=cambia-esto
# Firma de la cookie de sesión. Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-un-secreto-seguro
# true en producción (HTTPS vía Cloudflare): la cookie solo viaja cifrada.
COOKIE_SECURE=false
